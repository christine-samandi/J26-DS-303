# Copy to .env (git-ignored) and fill in. Never commit real keys.
GEMINI_API_KEY=paste_your_key_here
# Optional; default is gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
# Optional; 1 = connect over IPv4 only (when IPv6 to Google hangs), same as --ipv4
GEMINI_FORCE_IPV4=0
# Optional; 1 = send each result to C4's live assurance service, 0/unset = C1's mock C4
C4_LIVE=0
# Optional; where C4 runs (default http://localhost:8004)
C4_API_URL=http://localhost:8004
