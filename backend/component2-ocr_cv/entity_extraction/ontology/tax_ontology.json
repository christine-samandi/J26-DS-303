{
  "version": "0.1",
  "description": "Maps Component 2 output fields to Sri Lankan tax entities. Used by Component 3 (GraphRAG) to look up the governing rules. Legal references are indicative and must be confirmed with Component 3 / a tax expert.",
  "fields": {
    "issuer":           { "tax_entity": "EMPLOYER_OR_ISSUER",          "kind": "text" },
    "pay_period":       { "tax_entity": "INCOME_PERIOD",               "kind": "period" },
    "document_date":    { "tax_entity": "DOCUMENT_DATE",               "kind": "date" },
    "gross_income":     { "tax_entity": "EMPLOYMENT_INCOME",           "kind": "amount", "reference": "Inland Revenue Act No. 24 of 2017" },
    "epf_employee":     { "tax_entity": "EPF_EMPLOYEE_CONTRIBUTION",   "kind": "amount", "rate": 0.08, "reference": "EPF Act No. 15 of 1958" },
    "epf_employer":     { "tax_entity": "EPF_EMPLOYER_CONTRIBUTION",   "kind": "amount", "rate": 0.12, "reference": "EPF Act No. 15 of 1958" },
    "etf":              { "tax_entity": "ETF_EMPLOYER_CONTRIBUTION",   "kind": "amount", "rate": 0.03, "reference": "ETF Act No. 46 of 1980" },
    "apit":             { "tax_entity": "APIT_WITHHELD",               "kind": "amount", "reference": "Inland Revenue Act No. 24 of 2017" },
    "vat":              { "tax_entity": "VAT_CHARGED",                 "kind": "amount" },
    "sscl":             { "tax_entity": "SSCL_CHARGED",                "kind": "amount" },
    "total_deductions": { "tax_entity": "TOTAL_PAYROLL_DEDUCTIONS",    "kind": "amount" },
    "net_amount":       { "tax_entity": "NET_PAY",                     "kind": "amount" },
    "total_amount":     { "tax_entity": "DOCUMENT_TOTAL",              "kind": "amount" }
  }
}
