# Copy this file to .env and fill in real values. .env is git-ignored — never commit it.

# mock = serve the contract examples; graphrag = answer from the knowledge graph in Neo4j
C3_MODE=mock

# Neo4j (docker-compose.yml reads NEO4J_PASSWORD from here too; min 8 characters)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please

# Optional overrides
# C3_CHROMA_DIR=.chroma
# C3_RAW_DOCS_DIR=raw_regulatory_docs
# C3_PROCESSED_DIR=data/processed
# C3_EXTRACTED_DIR=data/extracted

# LLM extraction baseline (python -m evaluation.indexing_cost --llm gemini); free key from
# Google AI Studio. Never commit the real key.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Law monitor (python -m data_collection.monitor): pages to check and words that mark an
# income tax PDF (comma-separated). Defaults: the IRD Acts page; inland revenue, ir_act, ...
# C3_MONITOR_PAGES=https://www.ird.gov.lk/en/publications/sitepages/acts.aspx
# C3_MONITOR_KEYWORDS=inland revenue,ir_act,ir act,income tax
