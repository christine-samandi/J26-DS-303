{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j26-ds-303/contracts/schemas/ocr_output_schema.json",
  "title": "Component 2 OCR output",
  "description": "v0.2 - contract between Component 2 (OCR & CV) and Components 1, 3, 4. v0.2 is additive: invoices, receipts and quotations carry line_items, tax_components and attributes; payslips and bank statements still send schema_version 0.1 unchanged. Changes are logged in contracts/CONTRACT_CHANGELOG.md.",
  "type": "object",
  "required": [
    "schema_version",
    "doc_id",
    "document_type",
    "languages",
    "extracted_fields",
    "overall_confidence",
    "needs_review"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "doc_id": {
      "type": "string"
    },
    "document_type": {
      "enum": [
        "payslip",
        "bank_statement",
        "invoice",
        "receipt",
        "quotation",
        "unknown"
      ]
    },
    "languages": {
      "type": "array",
      "items": {
        "enum": [
          "si",
          "ta",
          "en"
        ]
      },
      "uniqueItems": true
    },
    "extracted_fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "overall_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "needs_review": {
      "type": "boolean"
    },
    "engine": {
      "type": "string",
      "description": "OCR engine(s) used, e.g. tesseract-5"
    },
    "processing_ms": {
      "type": "integer",
      "minimum": 0
    },
    "line_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/line_item"
      },
      "description": "v0.2: invoice/receipt/quotation items table"
    },
    "tax_components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tax_component"
      },
      "description": "v0.2"
    },
    "attributes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attribute"
      },
      "description": "v0.2: printed key-value facts, e.g. System Size: 5 kW"
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": [
        "field_name",
        "value",
        "confidence",
        "bbox",
        "needs_review"
      ],
      "additionalProperties": false,
      "properties": {
        "field_name": {
          "enum": [
            "issuer",
            "pay_period",
            "document_date",
            "gross_income",
            "epf_employee",
            "epf_employer",
            "etf",
            "apit",
            "vat",
            "sscl",
            "total_deductions",
            "net_amount",
            "total_amount",
            "document_number",
            "due_date",
            "seller_reg_no",
            "subtotal",
            "discount",
            "amount_paid",
            "balance_due",
            "previous_balance"
          ]
        },
        "value": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "raw_text": {
          "type": "string",
          "description": "Text exactly as read by OCR, before normalisation"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bbox": {
          "type": "array",
          "description": "[x, y, w, h] in pixels of the ORIGINAL uploaded image",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 4,
          "maxItems": 4
        },
        "tax_entity": {
          "type": "string",
          "description": "Ontology entity, e.g. EPF_EMPLOYEE_CONTRIBUTION"
        },
        "needs_review": {
          "type": "boolean",
          "description": "true when confidence < 0.95"
        }
      }
    },
    "line_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "confidence",
        "bbox",
        "needs_review"
      ],
      "properties": {
        "description": {
          "type": "string",
          "description": "Exactly as printed"
        },
        "quantity": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit_price": {
          "type": [
            "number",
            "null"
          ]
        },
        "discount": {
          "type": [
            "number",
            "null"
          ]
        },
        "tax_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "0.18 = 18%"
        },
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "amount_includes_tax": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "[x, y, w, h] in pixels of the ORIGINAL uploaded image"
        },
        "needs_review": {
          "type": "boolean"
        }
      }
    },
    "tax_component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "amount",
        "confidence",
        "bbox",
        "needs_review"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "VAT, SSCL, SGST, CGST ..."
        },
        "rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "amount": {
          "type": "number"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "[x, y, w, h] in pixels of the ORIGINAL uploaded image"
        },
        "needs_review": {
          "type": "boolean"
        }
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value",
        "confidence",
        "bbox"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "[x, y, w, h] in pixels of the ORIGINAL uploaded image"
        }
      }
    }
  }
}
