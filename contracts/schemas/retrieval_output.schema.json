{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/christine-samandi/J26-DS-303/contracts/schemas/retrieval_output.schema.json",
  "$comment": "GENERATED from contracts/j26_contracts by `python -m j26_contracts.export`. Do not edit.",
  "$defs": {
    "AppliesTo": {
      "additionalProperties": false,
      "properties": {
        "income_types": {
          "items": {
            "enum": [
              "employment",
              "business",
              "investment",
              "other"
            ],
            "type": "string"
          },
          "title": "Income Types",
          "type": "array"
        },
        "taxpayer_categories": {
          "items": {
            "enum": [
              "resident_individual",
              "non_resident_individual",
              "senior_citizen",
              "any"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Taxpayer Categories",
          "type": "array"
        }
      },
      "required": [
        "income_types",
        "taxpayer_categories"
      ],
      "title": "AppliesTo",
      "type": "object"
    },
    "Confidence": {
      "additionalProperties": false,
      "properties": {
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "level": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Level",
          "type": "string"
        },
        "components": {
          "$ref": "#/$defs/ConfidenceComponents"
        }
      },
      "required": [
        "score",
        "level",
        "components"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "ConfidenceComponents": {
      "additionalProperties": false,
      "properties": {
        "semantic_similarity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Semantic Similarity",
          "type": "number"
        },
        "graph_match": {
          "maximum": 1,
          "minimum": 0,
          "title": "Graph Match",
          "type": "number"
        },
        "extraction_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Extraction Confidence",
          "type": "number"
        },
        "temporal_match": {
          "maximum": 1,
          "minimum": 0,
          "title": "Temporal Match",
          "type": "number"
        }
      },
      "required": [
        "semantic_similarity",
        "graph_match",
        "extraction_confidence",
        "temporal_match"
      ],
      "title": "ConfidenceComponents",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "chunk_ids": {
          "items": {
            "pattern": "^CHUNK-[A-Z0-9_-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Chunk Ids",
          "type": "array"
        },
        "matched_text": {
          "description": "Verbatim source text. C4 verifies against it.",
          "minLength": 1,
          "title": "Matched Text",
          "type": "string"
        },
        "graph_path": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/GraphEdge"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graph Path"
        },
        "matched_entities": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/MatchedEntity"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matched Entities"
        }
      },
      "required": [
        "chunk_ids",
        "matched_text"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "GraphEdge": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "title": "From",
          "type": "string"
        },
        "relation": {
          "enum": [
            "DEFINED_IN",
            "APPLIES_TO",
            "AMENDS",
            "SUPERSEDES",
            "PART_OF",
            "HAS_BAND",
            "REFERS_TO"
          ],
          "title": "Relation",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "relation",
        "to"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "MatchedEntity": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "label": {
          "enum": [
            "AMOUNT",
            "RATE",
            "DATE",
            "SECTION_REF",
            "RELIEF",
            "DEDUCTION",
            "EXEMPTION",
            "INCOME_TYPE",
            "TAXPAYER_CATEGORY",
            "TAX_SLAB"
          ],
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "text",
        "label"
      ],
      "title": "MatchedEntity",
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "retrieval_mode": {
          "enum": [
            "graphrag",
            "flat_rag",
            "mock"
          ],
          "title": "Retrieval Mode",
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "number"
        },
        "corpus_version": {
          "minLength": 1,
          "title": "Corpus Version",
          "type": "string"
        },
        "embedding_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Model"
        },
        "candidates_considered": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidates Considered"
        },
        "confidence_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Method"
        }
      },
      "required": [
        "retrieval_mode",
        "latency_ms",
        "corpus_version"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "minimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "currency": {
          "const": "LKR",
          "title": "Currency",
          "type": "string"
        },
        "period": {
          "anyOf": [
            {
              "enum": [
                "year_of_assessment",
                "month",
                "one_off"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "QueryEcho": {
      "additionalProperties": false,
      "properties": {
        "query_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Text"
        },
        "as_of_date": {
          "format": "date",
          "title": "As Of Date",
          "type": "string"
        },
        "income_types": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "employment",
                  "business",
                  "investment",
                  "other"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Income Types"
        },
        "taxpayer_category": {
          "anyOf": [
            {
              "enum": [
                "resident_individual",
                "non_resident_individual",
                "senior_citizen",
                "any"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taxpayer Category"
        },
        "rule_types": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "tax_slab",
                  "tax_rate",
                  "relief",
                  "deduction",
                  "exemption",
                  "penalty",
                  "definition",
                  "other"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Types"
        },
        "rule_ids": {
          "anyOf": [
            {
              "items": {
                "pattern": "^RULE-[A-Z0-9_-]+$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Ids"
        },
        "top_k": {
          "maximum": 20,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        },
        "include_history": {
          "title": "Include History",
          "type": "boolean"
        }
      },
      "required": [
        "as_of_date",
        "top_k",
        "include_history"
      ],
      "title": "QueryEcho",
      "type": "object"
    },
    "RetrievedRule": {
      "additionalProperties": false,
      "properties": {
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "rule_id": {
          "description": "ID of this specific version of the rule.",
          "pattern": "^RULE-[A-Z0-9_-]+$",
          "title": "Rule Id",
          "type": "string"
        },
        "rule_key": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Shared by all versions.",
          "title": "Rule Key"
        },
        "rule_type": {
          "enum": [
            "tax_slab",
            "tax_rate",
            "relief",
            "deduction",
            "exemption",
            "penalty",
            "definition",
            "other"
          ],
          "title": "Rule Type",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "values": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleValues"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "applies_to": {
          "$ref": "#/$defs/AppliesTo"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "validity": {
          "$ref": "#/$defs/Validity"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "rank",
        "rule_id",
        "rule_type",
        "title",
        "text",
        "applies_to",
        "source",
        "validity",
        "confidence",
        "evidence"
      ],
      "title": "RetrievedRule",
      "type": "object"
    },
    "RuleValues": {
      "additionalProperties": false,
      "description": "Structured numbers for C1's deterministic engine. C1 must not parse numbers from text.",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cap": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rate_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Percent"
        },
        "bands": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SlabBand"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bands"
        }
      },
      "title": "RuleValues",
      "type": "object"
    },
    "SlabBand": {
      "additionalProperties": false,
      "properties": {
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "lower": {
          "minimum": 0,
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "null = no upper limit.",
          "title": "Upper"
        },
        "rate_percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Rate Percent",
          "type": "number"
        }
      },
      "required": [
        "order",
        "lower",
        "rate_percent"
      ],
      "title": "SlabBand",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "pattern": "^DOC-[A-Z0-9_-]+$",
          "title": "Document Id",
          "type": "string"
        },
        "document_title": {
          "minLength": 1,
          "title": "Document Title",
          "type": "string"
        },
        "document_type": {
          "enum": [
            "act",
            "amendment_act",
            "gazette",
            "circular",
            "notice",
            "guide"
          ],
          "title": "Document Type",
          "type": "string"
        },
        "act_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Act Number"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "subsection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subsection"
        },
        "paragraph": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph"
        },
        "schedule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "citation": {
          "description": "Ready-to-display citation for the user.",
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "published_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published Date"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "document_id",
        "document_title",
        "document_type",
        "citation"
      ],
      "title": "Source",
      "type": "object"
    },
    "Validity": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "replaced"
              }
            }
          },
          "then": {
            "properties": {
              "superseded_by": {
                "pattern": "^RULE-[A-Z0-9_-]+$",
                "type": "string"
              }
            },
            "required": [
              "superseded_by"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "active"
              }
            }
          },
          "then": {
            "properties": {
              "valid_to": {
                "type": "null"
              }
            }
          }
        }
      ],
      "description": "C3 versioning: when the rule applied, and what replaced it.",
      "properties": {
        "valid_from": {
          "format": "date",
          "title": "Valid From",
          "type": "string"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Last day in force (inclusive). null = still in force.",
          "title": "Valid To"
        },
        "status": {
          "description": "Lifecycle state TODAY.",
          "enum": [
            "active",
            "replaced",
            "outdated"
          ],
          "title": "Status",
          "type": "string"
        },
        "in_force_on_as_of_date": {
          "description": "Did the rule apply on the queried date?",
          "title": "In Force On As Of Date",
          "type": "boolean"
        },
        "superseded_by": {
          "anyOf": [
            {
              "pattern": "^RULE-[A-Z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Superseded By"
        },
        "supersedes": {
          "anyOf": [
            {
              "pattern": "^RULE-[A-Z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        },
        "changed_by_document_id": {
          "anyOf": [
            {
              "pattern": "^DOC-[A-Z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Changed By Document Id"
        }
      },
      "required": [
        "valid_from",
        "valid_to",
        "status",
        "in_force_on_as_of_date"
      ],
      "title": "Validity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Response from Component 3, consumed by C1 (calculation, citations) and C4 (verification). Owner: C3.",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "query": {
      "$ref": "#/$defs/QueryEcho"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/RetrievedRule"
      },
      "title": "Results",
      "type": "array"
    },
    "warnings": {
      "items": {
        "enum": [
          "NO_MATCH",
          "NO_RULE_IN_FORCE_ON_DATE",
          "LOW_CONFIDENCE",
          "AMBIGUOUS_QUERY",
          "AS_OF_DATE_BEFORE_CORPUS",
          "PARTIAL_CORPUS_COVERAGE"
        ],
        "type": "string"
      },
      "title": "Warnings",
      "type": "array",
      "uniqueItems": true
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "generated_at",
    "query",
    "results",
    "warnings",
    "metadata"
  ],
  "title": "RetrievalOutput",
  "type": "object"
}
